@page
@model IndexModel
@{
    ViewData["Title"] = "Spor & Beslenme Rehberi";
}

<style>
    body {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: #f8fafc;
        min-height: 100vh;
        margin: 0;
        padding: 0;
    }

    .custom-card {
        background: rgba(30, 41, 59, 0.9);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 16px;
    }

    .hero-img {
        width: 100%;
        height: 220px;
        object-fit: cover;
        border-radius: 14px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    }

    .btn-action {
        background: linear-gradient(90deg, #2563eb, #06b6d4);
        border: none;
        border-radius: 12px;
        font-size: 1.1rem;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
        touch-action: manipulation;
    }

        .btn-action:active {
            transform: scale(0.98);
            background: linear-gradient(90deg, #1d4ed8, #0891b2);
        }

    .select-dark {
        background-color: #334155 !important;
        color: #ffffff !important;
        border: 1px solid #475569 !important;
        border-radius: 12px;
        font-size: 1rem;
    }

        .select-dark option {
            background-color: #1e293b;
            color: #ffffff;
        }

    .macro-box {
        background: rgba(15, 23, 42, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        padding: 10px;
    }

    @@media (max-width: 576px) {
        .hero-img {
            height: 160px;
        }

        .main-title {
            font-size: 1.5rem !important;
        }
    }
</style>

<div class="container py-4 px-3">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 text-center">

            <img src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=1000&auto=format&fit=crop"
                 alt="Fitness Training"
                 class="hero-img mb-3" />

            <h1 class="main-title fw-bold text-white mb-2">Hedefine Uygun Rotayı Çiz 🎯</h1>
            <p class="text-secondary small mb-3">Mevcut boy ve kilonuzu seçin, antrenman ve beslenme stratejinizi saniyeler içinde öğrenin.</p>

            <div class="card custom-card p-3 p-md-4 mb-3 text-start shadow">
                <form method="post">
                    <div class="row g-2 mb-3">
                        <!-- Boy Seçimi -->
                        <div class="col-6">
                            <label for="boySecimi" class="form-label text-light fw-semibold small">Boyunuz:</label>
                            <select asp-for="SecilenBoy" class="form-select form-select-lg select-dark" id="boySecimi">
                                @for (int cm = 140; cm <= 200; cm += 5)
                                {
                                    <option value="@cm" selected="@(cm == 175 ? "selected" : null)">@cm cm</option>
                                }
                            </select>
                        </div>
                        <!-- Kilo Seçimi -->
                        <div class="col-6">
                            <label for="kiloSecimi" class="form-label text-light fw-semibold small">Kilonuz:</label>
                            <select asp-for="SecilenKilo" class="form-select form-select-lg select-dark" id="kiloSecimi">
                                @for (int kg = 45; kg <= 120; kg += 5)
                                {
                                    <option value="@kg" selected="@(kg == 75 ? "selected" : null)">@kg kg</option>
                                }
                            </select>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-action text-white w-100 fw-bold py-3">
                        Stratejiyi Oluştur 🚀
                    </button>
                </form>
            </div>

            @if (!string.IsNullOrEmpty(Model.TavsiyeBaslik))
            {
                <!-- KATEGORİ BAŞLIĞI -->
                <div class="card custom-card border-0 shadow text-start mt-3 mb-3">
                    <div class="card-body p-3">
                        <h5 class="card-title text-info mb-0 fw-bold">📌 @Model.TavsiyeBaslik</h5>
                    </div>
                </div>

                <!-- 1. AYRI KART: BESLENME VE MAKROLAR -->
                <div class="card custom-card border-0 shadow text-start mb-3">
                    <div class="card-header bg-transparent border-bottom border-secondary py-3">
                        <h5 class="card-title text-warning mb-0 fw-bold">🥗 Günlük Beslenme & Makro Hedefleri</h5>
                    </div>
                    <div class="card-body p-3 p-md-4">
                        <div class="row g-2 text-center mb-3">
                            <div class="col-3">
                                <div class="macro-box">
                                    <small class="text-secondary d-block">Kalori</small>
                                    <span class="fw-bold text-warning">@Model.GunlukKalori</span> <small class="text-muted">kcal</small>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="macro-box">
                                    <small class="text-secondary d-block">Protein</small>
                                    <span class="fw-bold text-danger">@Model.ProteinGram</span> <small class="text-muted">g</small>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="macro-box">
                                    <small class="text-secondary d-block">Karb</small>
                                    <span class="fw-bold text-info">@Model.KarbonhidratGram</span> <small class="text-muted">g</small>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="macro-box">
                                    <small class="text-secondary d-block">Yağ</small>
                                    <span class="fw-bold text-success">@Model.YagGram</span> <small class="text-muted">g</small>
                                </div>
                            </div>
                        </div>

                        <div class="p-3 rounded bg-dark border border-secondary">
                            <h6 class="text-light fw-bold mb-1">Beslenme Rehberi:</h6>
                            <p class="card-text text-secondary small lh-base mb-0">@Model.BeslenmeDetay</p>
                        </div>
                    </div>
                </div>

                <!-- 2. AYRI KART: ANTRENMAN PROGRAMI -->
                <div class="card custom-card border-0 shadow text-start">
                    <div class="card-header bg-transparent border-bottom border-secondary py-3">
                        <h5 class="card-title text-info mb-0 fw-bold">🏋️‍♂️ Antrenman Stratejisi</h5>
                    </div>
                    <div class="card-body p-3 p-md-4">
                        <p class="card-text text-light fs-6 lh-base mb-0">@Model.TavsiyeDetay</p>
                    </div>
                </div>
            }

        </div>
    </div>
</div>
